<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingBottom="8dp">

    <!-- Number row (toggleable) -->
    <LinearLayout
        android:id="@+id/number_row"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:background="@color/kb_number_bg"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="visible">
    </LinearLayout>

    <!-- Tone bar (dấu thanh) -->
    <LinearLayout
        android:id="@+id/tone_row"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">
    </LinearLayout>

    <!-- Vietnamese extra letters bar: ă, â, đ, ê, ô, ơ, ư -->
    <LinearLayout
        android:id="@+id/vn_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
    </LinearLayout>

    <!-- Main keyboard rows -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
    </LinearLayout>

    <!-- Emoji Panel (replaces key rows when active) -->
    <HorizontalScrollView
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:background="@color/kb_background">

        <LinearLayout
            android:id="@+id/emoji_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom row: emoji, space, delete -->
    <LinearLayout
        android:id="@+id/row_bottom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">
    </LinearLayout>

</LinearLayout>
