<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0D1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨️"
            android:textSize="64sp"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bàn Phím Tiếng Việt"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Vietnamese Keyboard"
            android:textSize="14sp"
            android:textColor="#FFAAAACC"
            android:layout_marginTop="4dp"/>

        <!-- Step 1 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#FF1A1A2E"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 1"
                    android:textSize="12sp"
                    android:textColor="#FF4ECDC4"
                    android:textAllCaps="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kích hoạt bàn phím"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vào Cài đặt → Quản lý bàn phím → Bật &quot;Bàn Phím Việt&quot;"
                    android:textSize="13sp"
                    android:textColor="#FFAAAACC"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btn_enable"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="🔧  Mở Cài Đặt"
                    android:textSize="15sp"
                    android:backgroundTint="#FF0F3460"
                    android:textColor="#FFFFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step 2 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FF1A1A2E"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 2"
                    android:textSize="12sp"
                    android:textColor="#FFFFE66D"
                    android:textAllCaps="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn làm bàn phím mặc định"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhấn nút bên dưới để chọn Bàn Phím Việt làm bàn phím mặc định"
                    android:textSize="13sp"
                    android:textColor="#FFAAAACC"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btn_select"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="⌨️  Chọn Bàn Phím"
                    android:textSize="15sp"
                    android:backgroundTint="#FFE94560"
                    android:textColor="#FFFFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Features -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FF1A1A2E"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Tính năng"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇻🇳  Đầy đủ 29 chữ cái tiếng Việt\n🎵  5 dấu thanh: sắc, huyền, ngã, hỏi, nặng\n🔢  Dãy phím số 1-9 (tắt/hiện)\n😊  Bộ emoji dễ thương khi chat\n🌙  Giao diện tối hiện đại\n⚡  Gõ nhanh với VNI/Telex"
                    android:textSize="14sp"
                    android:textColor="#FFCCCCDD"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with ❤️ for Vietnam"
            android:textSize="12sp"
            android:textColor="#FF666688"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
